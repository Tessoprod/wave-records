# Скопіюйте цей файл у .env і заповніть значення.

# Порт і адреса сайту
PORT=3000
# Повна адреса сайту без слеша в кінці (потрібна для push-сповіщень Google і посилань)
PUBLIC_URL=https://waverecords.ua
# 1 — якщо сайт працює за Caddy/nginx/Cloudflare
TRUST_PROXY=1
NODE_ENV=production

# Вхід в адмінку
ADMIN_USER=admin
# Пароль при першому запуску (далі змінюється в адмінці). Порожньо — згенерується і з'явиться в консолі.
ADMIN_PASSWORD=

# Google Calendar (див. README, розділ 4)
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
GOOGLE_CALENDAR_ID=

# Telegram-сповіщення про нові бронювання (необов'язково)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ліміти завантаження, МБ
MAX_AUDIO_MB=400
MAX_PHOTO_MB=25

# Де зберігати базу і файли
DATA_DIR=./data
